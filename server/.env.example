PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/playhub
# For local development without an installed MongoDB service, remove MONGO_URI
# and set USE_LOCAL_MONGO=true. Data persists in server/data/mongodb-rs.
USE_LOCAL_MONGO=false
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
TZ=Asia/Kolkata
